{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npx react-router build",
  "outputDirectory": "build/client",
  "trailingSlash": false,
  "redirects": [{ "source": "/", "destination": "/docs", "permanent": true }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
