# Environment indicator — controls sidebar color tint and badge.
# Valid values: dev, staging, production (default: production)
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_APP_URL=

# Optional frontend build metadata. Vercel builds derive these automatically.
NEXT_PUBLIC_APP_BUILD_ID=
NEXT_PUBLIC_APP_BUILD_TIME=
NEXT_PUBLIC_APP_GIT_REF=
NEXT_PUBLIC_APP_VERCEL_ENV=
NEXT_PUBLIC_APP_VERSION_POLL_INTERVAL_MS=120000

# Optional Vercel Web Analytics. Disabled unless explicitly set to true.
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Optional, read at runtime: where the Next server reaches Convex when that differs
# from the browser's URL (Docker service name). Used by Convex Auth's cookie session.
CONVEX_SERVER_URL=

# Optional backend build metadata for Settings → Developer.
# In production, set these on the Convex deployment before `convex deploy`.
CONVOY_BACKEND_BUILD_ID=
CONVOY_BACKEND_BUILD_TIME=
CONVOY_BACKEND_GIT_REF=
CONVOY_BACKEND_VERCEL_ENV=

# Optional GitHub integration (set on the Convex deployment, never NEXT_PUBLIC_).
# See apps/docs/content/docs/deployment/github-integration.mdx.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

# Auth mode, baked in at build time. clerk is the default, convex is Convex Auth
# with email and password, local-demo is one demo user with no sign-in.
# See docs/specs/auth-adapters.md.
# Choose it before the first user signs up. Switching later does not move accounts.
# Each mode matches only its own accounts, so a person who signs up again after a
# switch gets a new empty user. The old one comes back when you switch back.
NEXT_PUBLIC_AUTH_MODE=

# Convex Auth, set on the Convex deployment. AUTH_MODE=convex allows new accounts.
# Email verification is "required" unless AUTH_EMAIL_VERIFICATION is "off". While
# it is required, sign-up emails a link through Resend and fails without
# RESEND_API_KEY. EMAIL_FROM needs a domain verified in Resend. Convex Auth
# deployments also set a placeholder CLERK_JWT_ISSUER_DOMAIN.
AUTH_MODE=
AUTH_EMAIL_VERIFICATION=
RESEND_API_KEY=
EMAIL_FROM=
# Help address at the bottom of every email, on the Convex deployment. Unset leaves the line out.
SUPPORT_EMAIL=

# Clerk
## Clerk JWT Issuer Domain (get this from Clerk Dashboard → JWT Templates)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

## Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=

# Local agent browser verification. Disabled unless explicitly enabled.
# Signs a dedicated preview user into an agent's isolated browser: a short-lived
# Clerk sign-in token in Clerk mode, the user's password in Convex Auth mode.
CONVOY_AGENT_BROWSER_LOGIN_ENABLED=false
CONVOY_AGENT_BROWSER_AUTH_SECRET=
CONVOY_AGENT_BROWSER_USER_EMAIL=
# Convex Auth mode only. Worktree setup generates one per worktree; never share it.
CONVOY_AGENT_BROWSER_USER_PASSWORD=
CONVOY_AGENT_BROWSER_ALLOWED_HOSTS=localhost,127.0.0.1,::1,app.convoy,app.convoy.localhost
