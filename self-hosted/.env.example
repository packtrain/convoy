# --- Convex backend -----------------------------------------------------
# Public origins as reachable from browsers and CLI machines.
# For a single-machine local install the defaults are fine.
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211

# Keep stable across restarts (otherwise the admin key is invalidated).
# Generate a secret with: openssl rand -hex 32
INSTANCE_NAME=convoy
INSTANCE_SECRET=

# Set to true to disable the anonymous usage beacon Convex sends home.
DISABLE_BEACON=false

# Optional overrides. To use one, set it here AND uncomment the matching
# line in docker-compose.yml (they are not passed by default because the
# backend rejects empty values at boot).
# External Postgres/MySQL instead of the embedded SQLite volume:
# DATABASE_URL=postgresql://user:pass@host:5432
# Required when the external database connection has no TLS:
# DO_NOT_REQUIRE_SSL=true
# Hide server error details/log lines from connected clients:
# REDACT_LOGS_TO_CLIENT=true

# --- Web app -------------------------------------------------------------
# URL users open in the browser.
APP_URL=http://127.0.0.1:3000
# dev | staging | production — controls the environment badge in the UI.
APP_ENV=production
# Host that published container ports bind to. Loopback by default; only
# set 0.0.0.0 for clerk or convex installs that must be network-reachable.
# NEVER expose local-demo mode to a network — it has no authentication.
BIND_HOST=127.0.0.1

# --- Auth mode -------------------------------------------------------------
# local-demo — no accounts or sign-in; one demo user; loopback use only.
# convex     — real accounts with email and password, no outside service.
# clerk      — real accounts through Clerk (fill in the Clerk keys below).
# Choose it before the first user signs up: accounts do not move between modes.
# Baked into the web image at build time: after changing it, re-run start.sh
# so the image is rebuilt and the Convex deployment is kept in sync.
AUTH_MODE=

# --- Email through Resend ----------------------------------------------------
# AUTH_EMAIL_VERIFICATION applies to convex mode:
# required — sign-up emails a link through Resend; needs the two keys below.
# off      — no email; anyone who can reach the app can sign up under any
#            address. Suits instances that are not open to the internet.
# In convex mode start.sh asks for a Resend key and sets this; empty asks again.
# start.sh copies all three to the backend and removes any left empty, so set
# them here, not with `npx convex env set`. Without a key no email is sent;
# copy invitation links from Settings → Members.
AUTH_EMAIL_VERIFICATION=
RESEND_API_KEY=
# An address on a domain verified in Resend, e.g. Convoy <noreply@example.com>.
EMAIL_FROM=

# --- Clerk (required in clerk mode; cloud service, free tier is enough) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- GitHub integration (optional; clerk or convex mode) -----------------
# Set with `npx convex env set` on the backend, not read by compose. See
# https://docs.convoy.build/docs/deployment/github-integration.
# GITHUB_APP_ID= GITHUB_APP_SLUG= GITHUB_APP_PRIVATE_KEY= (PKCS#8)
# GITHUB_APP_CLIENT_ID= GITHUB_APP_CLIENT_SECRET= GITHUB_APP_WEBHOOK_SECRET=

# --- Google sign-in (optional; Convex Auth mode only) ----------------------
# Create a "Web application" OAuth client at
# https://console.cloud.google.com/apis/credentials with the redirect URI
# <CONVEX_SITE_ORIGIN>/auth/google/callback. start.sh sets both on the
# backend. `none` hides "Continue with Google"; Convex refuses to deploy
# with them unset, so keep `none` rather than leaving them empty.
AUTH_GOOGLE_CLIENT_ID=none
AUTH_GOOGLE_CLIENT_SECRET=none

# --- Deploying functions (used by scripts / npx convex, not by compose) --
# After first boot: docker compose exec backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=
