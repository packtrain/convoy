{
  "name": "@convoy/ink-pg",
  "version": "0.1.0",
  "description": "Ink CLI playground - exploring React for CLI applications",
  "type": "module",
  "bin": {
    "ink-pg": "./dist/bin/ink-pg.js"
  },
  "scripts": {
    "dev": "tsx bin/ink-pg.ts",
    "dev:watch": "tsx watch bin/ink-pg.ts",
    "build": "tsc",
    "start": "node dist/bin/ink-pg.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "ink-select-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^18.3.20",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
